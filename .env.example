# Copy to .env.local. Never commit real credentials.
# For a local demo only. Production must set this to false.
ENABLE_DEMO_DATA=true
# Leave blank to select Supabase automatically when its credentials are supplied.
# Set "memory" only for an explicitly enabled isolated demo.
DB_DRIVER=
NEXT_PUBLIC_ENABLE_DEMO_LOGIN=false
# Generate a random secret of at least 32 characters before deployment.
SESSION_SECRET=
APP_ORIGIN=http://localhost:3000
# Admin is created only when both values are supplied. First login requires a password change.
ADMIN_EMAIL=
ADMIN_INITIAL_PASSWORD=
# Required for accounts, quizzes, progress and learning-content storage.
NEXT_PUBLIC_SUPABASE_URL=
# Optional public anon/publishable key for browser integrations. It cannot replace
# the server key required by this app's protected accounts and admin operations.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=
# New Supabase server secret key, or the legacy service_role key below.
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# SMS OTP uses Supabase Auth. Enable its Phone provider, configure an SMS provider,
# and apply 20261007_first_login_otp.sql; see docs/OTP_SETUP.md.
# Use admin approval and temporary-password login without an SMS provider.
# Apply the admin_student_approval migration before selecting admin.
# sms retains first-login mobile verification when an SMS provider is configured.
STUDENT_ACTIVATION_MODE=direct
# Use official for cloud hosting: the in-site reader proxies verified SCERT PDFs.
# Local uses downloaded PDFs in public/textbooks.
TEXTBOOK_DELIVERY=local
# Local offline Gemma. Run npm run ai:setup once; npm run dev and npm start launch it automatically.
# Use excerpts to return study material without a model (for tests or low-memory hosts).
AI_PROVIDER=local
LOCAL_AI_BASE_URL=http://127.0.0.1:8080/v1
LOCAL_AI_MODEL=avs-gemma-3-1b
LOCAL_AI_TIMEOUT_MS=120000
# Optional paths for a manually installed runtime/model on another host.
LOCAL_AI_EXECUTABLE=
LOCAL_AI_MODEL_PATH=
